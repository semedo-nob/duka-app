# Local Spring Boot (dev profile) reads these if you export them.
# Defaults in application-dev.yml are for a laptop only. Change them before any shared deployment.

DATABASE_URL=jdbc:postgresql://localhost:5434/duka
DATABASE_USER=duka
DATABASE_PASSWORD=duka
DUKA_BOOTSTRAP_PHONE=0712345678
DUKA_BOOTSTRAP_PIN=changeme
DUKA_JWT_SECRET=dev-only-jwt-secret-change-before-any-deploy
MPESA_MODE=mock
MPESA_WEBHOOK_SECRET=dev-webhook-secret
# Leave blank until you have real Daraja credentials. Live mode will not fake a success.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
ETIMS_MODE=unconfigured
ETIMS_BASE_URL=
ETIMS_TIN=
# Platform administrator is separate from the shop owner.
# Dev profile defaults to phone 0700000000 and PIN 123456. Do not use those in production.
DUKA_PLATFORM_ADMIN_PHONE=
DUKA_PLATFORM_ADMIN_PIN=
# Leave empty. Set only while recovering a lost platform PIN, then clear it.
DUKA_PLATFORM_RECOVERY_CODE=
# Billing modes:
#   unconfigured — checkout stays locked (safe default)
#   mock         — development and test only. Refused when SPRING_PROFILES_ACTIVE=prod
#   paystack     — real charges. Production must use this with a secret key
# Put these in the API process environment, not in the till.
DUKA_BILLING_PROVIDER=unconfigured
DUKA_BILLING_SECRET_KEY=
DUKA_BILLING_PUBLIC_KEY=
DUKA_BILLING_WEBHOOK_SECRET=
# Browser return URL, for example https://shop.example.com/settings/billing
DUKA_BILLING_CALLBACK_URL=
# Public URL Paystack calls. Point it at POST https://api.example.com/api/integrations/billing/webhook
DUKA_BILLING_WEBHOOK_URL=
# Optional override. Production tills should point this at the hosted API.
DUKA_API_URL=
# CUPS queue name for the packaged desktop app. Leave blank to report printer-not-configured.
DUKA_PRINTER=
VITE_API_URL=http://localhost:4000/api
